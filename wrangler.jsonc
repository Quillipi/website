// Quillipi's homepage: only files, no code. Cloudflare serves public/ at quillipi.app.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quillipi-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "quillipi.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
